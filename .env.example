# ===== Relay server =====
HOST=127.0.0.1
PORT=8787
MCP_PATH=/mcp
AGENT_WS_PATH=/agent

# Required in production. Generate with: npm run secrets
# Keep these different. Do not commit the real values.
MCP_API_KEY=
AGENT_TOKEN=

# Optional: choose one device when multiple agents are connected.
TARGET_DEVICE_ID=home-pc

# Host and browser-origin protection. Host values are hostnames, without scheme or port.
# Public binds require this to be explicitly configured.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins or hostnames. Comparison uses hostname only;
# scheme and port are ignored, for example https://relay.example.com.
MCP_ALLOWED_ORIGINS=

# Limits
TOOL_CALL_TIMEOUT_MS=300000
MAX_PENDING_CALLS_PER_DEVICE=64
WS_MAX_PAYLOAD_BYTES=33554432
HTTP_BODY_LIMIT=32mb
AGENT_HELLO_TIMEOUT_MS=10000
WS_HEARTBEAT_MS=20000

# Development-only escape hatch. Never enable on a public interface.
ALLOW_INSECURE_LOCAL=false

# ===== Local relay agent =====
RELAY_WS_URL=wss://relay.example.com/agent
DEVICE_ID=home-pc
DEVICE_NAME=
# AGENT_TOKEN is shared with the server.

# Preferred if Desktop Commander is installed globally:
DESKTOP_COMMANDER_COMMAND=desktop-commander
DESKTOP_COMMANDER_ARGS_JSON=[]

# Alternative for a source checkout. If set, this takes precedence:
# DESKTOP_COMMANDER_ENTRY=../DesktopCommanderMCP/dist/index.js
# Optional explicit allowlist of additional environment names for the child.
# Never add relay credentials unless passing them through is intentional.
# DESKTOP_COMMANDER_ENV_ALLOWLIST=

AGENT_MAX_CONCURRENCY=4
AGENT_MAX_QUEUE=100
AGENT_RECONNECT_MIN_MS=1000
AGENT_RECONNECT_MAX_MS=30000
AGENT_RESULT_CACHE_SIZE=100
AGENT_TOOL_REFRESH_MS=60000
AGENT_WS_MAX_PAYLOAD_BYTES=33554432
