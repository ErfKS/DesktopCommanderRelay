# ===== Relay server =====
HOST=127.0.0.1
PORT=8787
MCP_PATH=/mcp
ACTION_PATH=/action
AGENT_WS_PATH=/agent

# Required in production. Generate with: npm run secrets
# Keep these different. Do not commit the real values.
MCP_API_KEY=
ACTION_API_KEY=
AGENT_TOKEN=

# ===== Optional OAuth 2.1 for ChatGPT Web =====
# Disabled by default. When enabled, MCP_API_KEY may remain set for legacy clients.
MCP_OAUTH_ENABLED=false
# Use the public HTTPS origin, without a path, for the authorization server issuer.
MCP_OAUTH_ISSUER_URL=https://mcp-relay.example.com
# Use the canonical MCP resource URL. ChatGPT sends this exact value as `resource`.
MCP_OAUTH_RESOURCE_URL=https://mcp-relay.example.com/mcp
# Use /var/lib/desktop-commander-relay/oauth on systemd; this directory must persist across deploys.
MCP_OAUTH_DATA_DIR=./data/oauth
# Provision with: npm run oauth:owner -- relay-owner (see docs/OAUTH.md).
MCP_OAUTH_OWNER_USERNAME=
MCP_OAUTH_OWNER_PASSWORD_HASH=
MCP_OAUTH_SCOPES=mcp:read,mcp:write
MCP_OAUTH_DEFAULT_SCOPES=mcp:read,mcp:write
# Keep the default conservative. Add exact tool names deliberately when enabling remote tools.
MCP_OAUTH_ALLOWED_TOOLS=relay_status,relay_list_devices
# Empty means no Desktop Commander device is OAuth-authorized.
MCP_OAUTH_ALLOWED_DEVICE_IDS=
# Optional exact redirect URI allowlist. When empty, only the documented ChatGPT URLs are accepted.
MCP_OAUTH_ALLOWED_REDIRECT_URIS=
MCP_OAUTH_ACCESS_TOKEN_LIFETIME_SEC=3600
MCP_OAUTH_REFRESH_TOKEN_LIFETIME_SEC=1209600
MCP_OAUTH_AUTHORIZATION_CODE_LIFETIME_SEC=300
MCP_OAUTH_SESSION_LIFETIME_SEC=1800

# Optional: choose one device when multiple agents are connected.
TARGET_DEVICE_ID=home-pc

# ChatGPT Action process/session policy.
# Empty by default. Example: home-pc-sandbox,webdade
# IMPORTANT: this is an authorization list; adding a device does not sandbox it.
ACTION_SANDBOX_DEVICE_IDS=

# Vision Bridge.
# Empty by default; image analysis requires an explicit allowed device.
# Keep OPENAI_API_KEY only on the Relay Server and never commit a real value.
ACTION_VISION_DEVICE_IDS=
OPENAI_API_KEY=
VISION_MODEL=gpt-5.6
VISION_MAX_IMAGE_BYTES=5242880
VISION_MAX_PROMPT_CHARS=12000
VISION_MAX_OUTPUT_TOKENS=4000
VISION_OPENAI_TIMEOUT_MS=60000

# Temporary Image Bridge.
# Both endpoints require an explicit device in this allowlist.
ACTION_IMAGE_DEVICE_IDS=
IMAGE_BRIDGE_ALLOWED_ROOTS=/projects,/workspace
IMAGE_BRIDGE_STORAGE_DIR=./tmp/image-bridge
IMAGE_BRIDGE_MAX_BYTES=10485760
IMAGE_BRIDGE_TTL_MS=86400000
IMAGE_BRIDGE_CLEANUP_INTERVAL_MS=900000
# Set this when the Relay is behind a public HTTPS reverse proxy.
IMAGE_BRIDGE_PUBLIC_BASE_URL=

# Host and browser-origin protection. Host values are hostnames, without scheme or port.
# Public binds require this to be explicitly configured.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins or hostnames. Comparison uses hostname only;
# scheme and port are ignored, for example https://relay.example.com.
MCP_ALLOWED_ORIGINS=

# Limits
TOOL_CALL_TIMEOUT_MS=300000
MAX_PENDING_CALLS_PER_DEVICE=64
WS_MAX_PAYLOAD_BYTES=33554432
HTTP_BODY_LIMIT=32mb
AGENT_HELLO_TIMEOUT_MS=10000
WS_HEARTBEAT_MS=20000

# Development-only escape hatch. Never enable on a public interface.
ALLOW_INSECURE_LOCAL=false

# ===== Local relay agent =====
RELAY_WS_URL=wss://relay.example.com/agent
DEVICE_ID=home-pc
DEVICE_NAME=
# AGENT_TOKEN is shared with the server.

# Preferred if Desktop Commander is installed globally:
DESKTOP_COMMANDER_COMMAND=desktop-commander
DESKTOP_COMMANDER_ARGS_JSON=[]

# Alternative for a source checkout. If set, this takes precedence:
# DESKTOP_COMMANDER_ENTRY=../DesktopCommanderMCP/dist/index.js
# Optional explicit allowlist of additional environment names for the child.
# Never add relay credentials unless passing them through is intentional.
# DESKTOP_COMMANDER_ENV_ALLOWLIST=

AGENT_MAX_CONCURRENCY=4
AGENT_MAX_QUEUE=100
AGENT_RECONNECT_MIN_MS=1000
AGENT_RECONNECT_MAX_MS=30000
AGENT_RESULT_CACHE_SIZE=100
AGENT_TOOL_REFRESH_MS=60000
AGENT_WS_MAX_PAYLOAD_BYTES=33554432
