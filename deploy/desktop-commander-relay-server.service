[Unit]
Description=Desktop Commander Relay Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/DesktopCommanderRelay
EnvironmentFile=/opt/DesktopCommanderRelay/.env
ExecStart=/usr/bin/node /opt/DesktopCommanderRelay/dist/server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/DesktopCommanderRelay

[Install]
WantedBy=multi-user.target
