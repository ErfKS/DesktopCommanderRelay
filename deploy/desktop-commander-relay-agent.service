[Unit]
Description=Desktop Commander Relay Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/DesktopCommanderRelay
EnvironmentFile=%h/.config/desktop-commander-relay/agent.env
ExecStart=/usr/bin/node %h/DesktopCommanderRelay/dist/agent/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
