{
  "name": "desktop-commander-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted relay between remote MCP clients and a local Desktop Commander MCP process",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:server": "tsx src/server/index.ts",
    "dev:agent": "tsx src/agent/index.ts",
    "start:server": "node dist/server/index.js",
    "start:agent": "node dist/agent/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run build && npm run typecheck && npm test",
    "secrets": "node scripts/generate-secrets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/send": "^1.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
